# ---------------------------------------------------------------------------
# Copy to .env and adjust. All values can also be supplied as real environment
# variables. The TMDB token is read from this file in
# Frontend/movie_dataset_builder/.env for dataset collection and server-side
# watch-provider lookups. It is never sent to the browser or stored in artifacts.
# ---------------------------------------------------------------------------

# Flask / runtime
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=replace-with-a-random-value-for-production

# Data locations (relative paths resolve from the project root)
DATASET_PATH=Frontend/movie_dataset_builder/output/all_titles.csv
MODEL_DIR=model

# Poster search order: first valid local image wins. Movie files use <tmdb_id>;
# TV files use tv-<tmdb_id>, so movie and series IDs can never collide.
POSTER_DIRS=assets/posters,Frontend/movie_dataset_builder/output/posters,Frontend/movie_dataset_builder/output/tv_posters
BACKDROP_DIRS=assets/backdrops
FALLBACK_POSTER_URL=/media/fallback/poster.svg

# Poster behaviour
ALLOW_REMOTE_POSTERS=true
REMOTE_IMAGE_HOSTS=image.tmdb.org
AUTO_DOWNLOAD_POSTERS=false
DOWNLOAD_TIMEOUT_SECONDS=10
POSTER_CACHE_TTL_SECONDS=60
MEDIA_CACHE_MAX_AGE=3600

# Watch providers / cinema links (server-side only)
# The bearer token is read from Frontend/movie_dataset_builder/.env first.
WATCH_REGION=IN
WATCH_TIMEOUT_SECONDS=6
WATCH_CACHE_TTL_SECONDS=21600

# API / startup
REQUIRE_MODEL_AT_STARTUP=true
DEFAULT_PER_PAGE=24
MAX_PER_PAGE=100
MAX_SEARCH_RESULTS=50

# Anonymous recommendation personalisation (in-memory, cookie-keyed)
REPETITION_PENALTY_HALF_LIFE_SECONDS=21600
REPETITION_PENALTY_WINDOW_SECONDS=86400
REPETITION_PENALTY_STRENGTH=0.55
RL_LEARNING_RATE=0.25
RL_EXPLORATION_RATE=0.08
RL_TITLE_BONUS=0.45
RL_CONTEXT_BONUS=0.25
PERSONALIZATION_SESSION_MAX_AGE_SECONDS=604800
PERSONALIZATION_MAX_SESSIONS=5000

# Local training (Kaggle uses /kaggle/input and /kaggle/working instead)
TRAIN_CSV=Frontend/movie_dataset_builder/output/all_titles.csv
TRAIN_OUTPUT_DIR=model
TRAIN_POSTERS_DIR=Frontend/movie_dataset_builder/output/posters
